# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------- Virtual environments ----------
.venv/
venv/
env/

# ---------- Secrets / local config ----------
.env
kaggle.json

# ---------- VS Code (keep shared settings, ignore the rest) ----------
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json

# ---------- Jupyter ----------
.ipynb_checkpoints/

# ---------- Datasets (keep the folders, ignore the contents) ----------
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# ---------- Model weights / checkpoints ----------
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors
*.h5
*.joblib
*.pkl
models/*
!models/.gitkeep

# ---------- Generated outputs (reports, plots, Grad-CAM images) ----------
outputs/*
!outputs/.gitkeep

# ---------- OS junk ----------
Thumbs.db
Desktop.ini
.DS_Store
